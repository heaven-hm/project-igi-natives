  MakeNameEx(0x0044D750, "AIAction_PlaySound", SN_NOWARN);
  SetFunctionCmt(0x0044D750, "Plays a sound from the AI (voice barks etc.). Params: soundId = sound/event id, param2 = observed 0 in retail, flags = AIACTIONFLAG (NONE=0/PUSHABLE=1).", 1);
  MakeNameEx(0x0044D7D0, "AIAction_MoveToEvent", SN_NOWARN);
  SetFunctionCmt(0x0044D7D0, "Moves the AI toward the source position of an EVENT it received. Params: eventId = AIEVENT_* whose position to move to, flags = AIACTIONFLAG (NONE=0/PUSHABLE=1). Use in event handlers (gunshot heard -> move there).", 1);
  MakeNameEx(0x0044D870, "AIAction_LookAtEvent", SN_NOWARN);
  SetFunctionCmt(0x0044D870, "Turns the AI to LOOK toward an event's source without moving. Params: eventId = AIEVENT_* value, flags = AIACTIONFLAG (NONE=0/PUSHABLE=1).", 1);
  MakeNameEx(0x0044D8F0, "AIAction_Stunned", SN_NOWARN);
