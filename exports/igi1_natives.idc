  MakeNameEx(0x0044D630, "AIAction_FireAtTask", SN_NOWARN);
  SetFunctionCmt(0x0044D630, "Makes the AI fire AT a task/object entity. Params: taskId = target task/entity id, remaining 4 args = firing behaviour values (same layout family as FireAtNode). Use in combat handlers when target is an entity.", 1);
  MakeNameEx(0x0044D6E0, "AIAction_PlayAnimation", SN_NOWARN);
