  SetFunctionCmt(0x00406220, "RETURNS pointer to the ACTIVE PROFILE's graphic-options/config record: computed as 0xBC2388 + 0xD14*[0xBC2384] (verified against retail defaults-reset fcn.00403B70 which walks the same layout). Takes no args. Despite the historical name this returns a record pointer, not a bool. Old analyst name IsPlayerProfileActive was wrong - it returns the record pointer, not a bool.", 1);
  MakeNameEx(0x0045C440, "Soldier_Execute", SN_NOWARN);
  SetFunctionCmt(0x0045C440, "Executes/initializes a SOLDIER AI entity in the level. Params: context = task/context object (2nd arg is the soldier ptr - verified: esi=[esp+0x1C] after prologue). The function reads soldier-struct fields +0x800 (ptr), +0x4C4 and +0x254 (sub-object bases passed to spawner 0x4F2060), +0xD1C, then installs a per-soldier callback (0x45C700) into the created object at +0x14 and routes through 0x48A330. Referenced via soldier-task VTABLE at .data 0x53EC90 (not called directly). SOLDIER STRUCT LAYOUT (recovered from the 0x45C190-0x45CA50 vtable family): +0x68 name/string area; +0x254 patrol/waypoint sub-struct (field +0x94 used); +0x2EC param ptr slot; +0x33D flag byte; +0x4C4 object ref; +0x696 active/enable flag (0=off, 1=on); +0x800 ptr; +0xD0C id (0xFFFFFFFF = unset); +0xD14 dword; +0xD1C ptr. Sibling vtable methods: 0x45C190, 0x45C1C0, 0x45C2E0, 0x45C330, 0x45C5A0, 0x45C650, 0x45C750, 0x45C8B0, 0x45CA50 (same struct, enable/disable/reset semantics).", 1);
  MakeNameEx(0x00402780, "Flow_RequestEvent", SN_NOWARN);
  SetFunctionCmt(0x00402780, "Requests a flow-task event by id (drives the level's flow state machine). Param: eventId = flow event number used in the level flow script. Use from mission flow scripts to trigger scripted transitions. FLOW_EVENT enum: None=0, QUIT=1, INTRO=2, MAINMENU=3, GAME=4, RESTART_GAME=5 (events 6-8 exist internally but have no registered constants).", 1);
  MakeNameEx(0x004036B0, "GO_Player", SN_NOWARN);
  SetFunctionCmt(0x004036B0, "Adds a player profile named 'name' to the config while a .cfg/GO script block is being read; subsequent GO_* settings apply to this profile. Param: name = profile display name (string). Use inside config/profile scripts, must come before that profile's GO_* settings. Returns 1.", 1);
  MakeNameEx(0x004037C0, "GO_InRemap", SN_NOWARN);
  SetFunctionCmt(0x004037C0, "Adds one input binding (key remap) to the current profile. Params: key1 = primary key code, key2 = secondary key code, action = in-game action id being bound. Use in input/config scripts, repeat once per binding. Returns 1.", 1);
  MakeNameEx(0x00403870, "GO_InMouInv", SN_NOWARN);
  SetFunctionCmt(0x00403870, "Toggles inverted mouse-look for the current profile. Param: invert = 1 invert Y axis, 0 normal. Use in config scripts. Returns 1.", 1);
  MakeNameEx(0x004038E0, "GO_InMouSens", SN_NOWARN);
  SetFunctionCmt(0x004038E0, "Sets mouse sensitivity for the current profile. Param: sensitivity = float multiplier as saved by the options screen. Use in config scripts. Returns 1.", 1);
  MakeNameEx(0x00403950, "GO_GfxDisp", SN_NOWARN);
  SetFunctionCmt(0x00403950, "Sets display-mode selection for the current profile. Param: displayMode = mode index from the retail display list (see Display_GetActiveMode/display table). Use in config scripts. igi.exe registers it with argc=3 at its site; the extra args go unused by the setter itself.", 1);
  MakeNameEx(0x00404010, "GO_GfxDevice", SN_NOWARN);
  SetFunctionCmt(0x00404010, "Sets render-device (D3D device/GUID) selection for the current profile. Param: deviceIndex = index into the render-device list filled by Config_FillRenderDeviceListBox. Use in config scripts. Returns 1.", 1);
  MakeNameEx(0x00404080, "GO_GfxGamma", SN_NOWARN);
  SetFunctionCmt(0x00404080, "Sets gamma for the current profile. Param: gamma = float, retail default 1.0 (range ~0.5-3.0 clamped elsewhere). Use in config scripts. Returns 1.", 1);
  MakeNameEx(0x00403A00, "GO_GameLang", SN_NOWARN);
  SetFunctionCmt(0x00403A00, "Sets game language for the current profile. Param: language = language index (retail ships English=0 and German builds use their own index). Use in config scripts. Returns 1.", 1);
  MakeNameEx(0x00403AC0, "GO_GameDiff", SN_NOWARN);
  SetFunctionCmt(0x00403AC0, "Sets game difficulty for the current profile. Param: difficulty = 0 easy, 1 medium, 2 hard (retail order). Use in config scripts. Returns 1.", 1);
  MakeNameEx(0x00403DF0, "GO_IsBlood", SN_NOWARN);
  SetFunctionCmt(0x00403DF0, "Toggles blood effects for the current profile. Param: blood = 1 on, 0 off. Use in config scripts. Returns 1.", 1);
  MakeNameEx(0x00403E60, "GO_SoundSpeech", SN_NOWARN);
