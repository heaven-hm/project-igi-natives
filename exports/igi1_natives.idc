  MakeNameEx(0x00403C10, "GO_ContentControlPW", SN_NOWARN);
  SetFunctionCmt(0x00403C10, "Config-writer form (argc=1): sets the content-control password while a config file is parsed. Param: password = string. Returns 1.", 1);
