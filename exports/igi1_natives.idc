  MakeNameEx(0x0044DD30, "AIFunction_SetViewAlpha", SN_NOWARN);
  SetFunctionCmt(0x0044DD30, "Sets view ALPHA - the detection speed/gain of normal vision. Param: alpha = engine detection factor. Higher = spots player faster. Use in AIEVENT_CREATE.", 1);
