  MakeNameEx(0x0044E4F0, "AIFunction_GetAlarmControlStatus", SN_NOWARN);
  SetFunctionCmt(0x0044E4F0, "RETURNS the status/state of the bound alarm control (raised/used state as tracked by the engine). Takes no args.", 1);
  MakeNameEx(0x0044E5E0, "AIFunction_GetGunnerStatus", SN_NOWARN);
