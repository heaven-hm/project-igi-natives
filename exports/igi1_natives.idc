  MakeNameEx(0x0044D960, "AIAction_KickGrenade", SN_NOWARN);
  SetFunctionCmt(0x0044D960, "Kicks a nearby live grenade away (retail soldier behaviour). Param: param = grenade/context reference from the event. Use in grenade-event handlers.", 1);
  MakeNameEx(0x0044DA00, "AIAction_RunPanicking", SN_NOWARN);
