  MakeNameEx(0x0044EBB0, "AIFunction_AddAnimationEntry", SN_NOWARN);
  SetFunctionCmt(0x0044EBB0, "Adds an animation ENTRY to this AI's available set (builds the pick-list GetAnimationToPlay draws from). Params: animationId = animation resource id, data = entry config value. Use in AIEVENT_CREATE before playing custom animations.", 1);
  MakeNameEx(0x0044EE40, "AIFunction_SendResponse", SN_NOWARN);
  SetFunctionCmt(0x0044EE40, "Sends the AI's RESPONSE to the current event (used for ALERT_RESPONSE chains so buddy AIs react too). Takes no args. Call inside alert handlers.", 1);
  MakeNameEx(0x0047CAD0, "Define_AmmoType", SN_NOWARN);
  SetFunctionCmt(0x0047CAD0, "Defines an AMMO TYPE inside an ammo definition block of a .qsc/.cfg script (515-byte parser body; igi.exe embeds str 'DefineAmmoType'). Args follow the Define-ammo grammar (name, damage, range, clip...) - not fully mapped, treat as parser-internal. Do NOT call outside its define block.", 1);
  MakeNameEx(0x00484F60, "Define_Mission", SN_NOWARN);
