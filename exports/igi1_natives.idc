  MakeNameEx(0x0044E0C0, "AIFunction_SetEventPriority", SN_NOWARN);
  SetFunctionCmt(0x0044E0C0, "Sets the priority of the CURRENT event being handled (decides which queued event wins). Param: priority = engine priority number. Use inside an event handler.", 1);
  MakeNameEx(0x0044E150, "AIFunction_SetInvulnerability", SN_NOWARN);
  SetFunctionCmt(0x0044E150, "Makes this AI invulnerable. Param: onOff = 1 immune to damage, 0 normal. Great for boss/scripted NPCs. Use in AIEVENT_CREATE or anytime.", 1);
  MakeNameEx(0x0044E1B0, "AIFunction_SetInstantDeath", SN_NOWARN);
