  MakeNameEx(0x004F0780, "Task_New", SN_NOWARN);
  SetFunctionCmt(0x004F0780, "Instantiates a new game task from a declared type (731-byte factory; OpenIGI registers Task_New reading the type name then declared params). Call inside task blocks after Task_DeclareParameters; argc unknown (parser context).", 1);
  MakeNameEx(0x004F0740, "Task_DeclareParameters", SN_NOWARN);
