  MakeNameEx(0x00403EF0, "GO_SoundMusic", SN_NOWARN);
  SetFunctionCmt(0x00403EF0, "Sets music volume for the current profile. Param: volume = float 0.0-1.0. Use in config scripts. Returns 1.", 1);
  MakeNameEx(0x00403F80, "GO_SoundFX", SN_NOWARN);
  SetFunctionCmt(0x00403F80, "Sets sound-effects volume for the current profile. Param: volume = float 0.0-1.0. Use in config scripts. Returns 1.", 1);
  MakeNameEx(0x004040F0, "GO_GfxPerformance", SN_NOWARN);
  SetFunctionCmt(0x004040F0, "Sets graphics performance/detail flags for the current profile. Param: flags = bitmask from the detail-level mapping (see Config_GraphicOptionsGetPerfFlagsFromLevel). Use in config scripts. Returns 1.", 1);
