  MakeNameEx(0x00488E00, "LevelFlow_GetBreakCutSceneKey", SN_NOWARN);
  SetFunctionCmt(0x00488E00, "RETURNS the key code currently bound to 'skip/break cutscene'. Takes no args. Use in cutscene player loops to detect the skip key press.", 1);
  MakeNameEx(0x00488E50, "LevelFlow_LevelFailed", SN_NOWARN);
  SetFunctionCmt(0x00488E50, "Signals that the level FAILED - triggers the retail failure flow (fail sound, restart/quit menu). Takes no args. Call when your scripted objective fails.", 1);
  MakeNameEx(0x00488E90, "LevelFlow_IsCountryUSA", SN_NOWARN);
  SetFunctionCmt(0x00488E90, "RETURNS 1 if the running build is a USA country build, 0 otherwise (affects censorship/content paths like blood). Takes no args. Check before enabling content that country builds gate.", 1);
  MakeNameEx(0x004B8C60, "Script_SetWarningLevel", SN_NOWARN);
  SetFunctionCmt(0x004B8C60, "Sets how loudly the script system reports warnings while parsing/running (igi.exe embeds its name WITH leading underscore: '_Script_SetWarningLevel'). Param: level = warning verbosity threshold. Use at the top of scripts you want silenced or extra-chatty.", 1);
  MakeNameEx(0x004B8C10, "Break_Script", SN_NOWARN);
  SetFunctionCmt(0x004B8C10, "Breaks/aborts the currently-executing script at this point (70-byte function). Takes no args. Use as an early-exit inside .qsc scripts.", 1);
  MakeNameEx(0x004C4520, "Define_MagicObj", SN_NOWARN);
