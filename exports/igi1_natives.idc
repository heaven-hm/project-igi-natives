  SetFunctionCmt(0x0044D420, "Generic ACTIVATE action: sends the AI to activate/use an object (switch, door, alarm...). Params: target = object/task reference, param2 = secondary value (retail passes 0), flags = AIACTIONFLAG (NONE=0/PUSHABLE=1). Use in AI handlers for alarm/objective responses.", 1);
  MakeNameEx(0x0044D4A0, "AIAction_WalkToNode", SN_NOWARN);
  SetFunctionCmt(0x0044D4A0, "Walks the AI to a nav node. Params: nodeId = graph/node id from the level nav data, flags = AIACTIONFLAG (NONE=0/PUSHABLE=1). Use for calm movement in AI scripts.", 1);
  MakeNameEx(0x0044D510, "AIAction_RunToNode", SN_NOWARN);
