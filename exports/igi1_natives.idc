  MakeNameEx(0x0044DA80, "AIAction_Idle", SN_NOWARN);
  SetFunctionCmt(0x0044DA80, "Puts the AI into IDLE (stands, resumes idle animation countdown). Param: idle context value (retail scripts pass their idle value). Use in AIEVENT_IDLE handler instead of Patrol for stationary guards.", 1);
  MakeNameEx(0x0044DAE0, "AIAction_SetCombat", SN_NOWARN);
  SetFunctionCmt(0x0044DAE0, "Force-sets the AI's COMBAT ENEMY/target. Param: enemyId = enemy entity/id to engage. Use to make an AI attack a specific target regardless of detection.", 1);
  MakeNameEx(0x0044E060, "AIFunction_DefaultHandler", SN_NOWARN);
  SetFunctionCmt(0x0044E060, "The default AI event handler: call this for any AIEVENT_* your script does not handle explicitly (retail template shows it as the else-branch body). Takes no args. Put inside every event if-else chain as fallback.", 1);
  MakeNameEx(0x0044DBC0, "AIFunction_RemoveAlarmActions", SN_NOWARN);
  SetFunctionCmt(0x0044DBC0, "Removes all queued ALARM-related actions from this AI (calms it down). Takes no args. Use to de-escalate an NPC you control.", 1);
  MakeNameEx(0x0044DC40, "AIFunction_SetViewLength", SN_NOWARN);
