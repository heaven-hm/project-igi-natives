  MakeNameEx(0x0044E330, "AIFunction_SetAlarmAccess", SN_NOWARN);
  SetFunctionCmt(0x0044E330, "Sets HOW the AI treats the alarm route. Param: access = AIALARMACCESS enum: BEFORECOMBAT=0 (run for the alarm first), AFTERCOMBAT=1 (fight first, raise alarm after). Retail template: AIFunction_SetAlarmAccess(AIALARMACCESS_BEFORECOMBAT).", 1);
  MakeNameEx(0x0044E390, "AIFunction_SetGunnerID", SN_NOWARN);
