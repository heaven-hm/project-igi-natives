  MakeNameEx(0x0044E3F0, "AIFunction_GetAlarmTriggerID", SN_NOWARN);
  SetFunctionCmt(0x0044E3F0, "RETURNS the id of the alarm trigger bound to this AI (see AIFunction_SetAlarmTriggerID). Takes no args. Use in handlers to check which alarm applies.", 1);
  MakeNameEx(0x0044E430, "AIFunction_GetAlarmControlID", SN_NOWARN);
